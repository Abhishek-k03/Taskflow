# TaskFlow API Configuration (example)
#
# Server-side only - the browser always calls this Next.js server's same-origin
# /api, /health, and /ws. /api and /health are read fresh on every request;
# /ws is a next.config.ts rewrite, so it's fixed at build time (see the
# comment there). Only needs setting if the backend isn't at localhost:8000.
TASKFLOW_BACKEND_URL=http://localhost:8000

# Sent as X-API-Key on every proxied request, and appended to the /ws rewrite
# as ?token=. Required when the backend has TASKFLOW_API_KEYS set, which
# docker compose does by default - without it the dashboard gets 401 on every
# mutating action and the WebSocket handshake is rejected with 403.
#
# The browser never sees this. It calls this server's own origin, and the key
# is attached here, server-side.
TASKFLOW_API_KEY=local-dev-key
